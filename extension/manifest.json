{
  "manifest_version": 3,
  "name": "Vibink",
  "version": "2.0.1",
  "description": "Vibe it. Ink it. Ship it. Draw and point on any webpage while coding with Codex.",
  "icons": {
    "16": "vibink-icon-16.png",
    "32": "vibink-icon-32.png",
    "48": "vibink-icon-48.png",
    "128": "vibink-icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vibink-mark.svg"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "vibink-icon-16.png",
      "32": "vibink-icon-32.png",
      "48": "vibink-icon-48.png",
      "128": "vibink-icon-128.png"
    },
    "default_title": "Open Vibink",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-vibink": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Toggle Vibink on the current page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
